DATABASE_URL="file:./dev.db"

SERVER_PORT=3001
WEB_PORT=5173

CORS_ORIGIN=http://localhost:5173

EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

DEFAULT_ROUND_DURATION_SECONDS=300
CORRECT_THRESHOLD=0.98
TOP_RANK_LIMIT=15

# 轮间公布答案后，自动开始下一轮的等待秒数
INTER_ROUND_DELAY_SECONDS=6

# 抖音/外部弹幕采集程序调用 ingest、gift 接口的鉴权 token
INGEST_TOKEN=dev-token
